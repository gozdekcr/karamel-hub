# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Only these two values go to the browser (VITE_ prefix). Never put the secret key
# (sb_secret_…) in any VITE_ variable (SECURITY.md K1, K2; ADR-0027).

# Local stack: printed by `npx supabase start` / `npx supabase status` (API URL).
VITE_SUPABASE_URL=
# Publishable key only (sb_publishable_…), never the legacy anon key (SECURITY.md K4).
VITE_SUPABASE_PUBLISHABLE_KEY=
