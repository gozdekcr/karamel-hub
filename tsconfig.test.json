{
  // Unit tests next to the source files: same settings as the app, plus Node types
  // (tests may read files), so browser code never sees Node APIs.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.d.ts"],
  "exclude": []
}
